# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa_example

STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:8000

# Generate fresh values: openssl rand -base64 32
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# Public URL of this backend. Monobank sends webhooks to
# ${MEDUSA_BACKEND_URL}/hooks/payment/monobank_monobank, so it must be reachable
# from the internet (use a tunnel such as ngrok or cloudflared locally).
MEDUSA_BACKEND_URL=http://localhost:9000

# Monobank acquiring token (https://web.monobank.ua -> "Інтернет-еквайринг").
# A test token from https://api.monobank.ua works with test cards.
# Leave empty and the provider is not registered at all.
MONOBANK_TOKEN=
# Where the bank sends the shopper after paying (your storefront page).
MONOBANK_REDIRECT_URL=http://localhost:8000/checkout/result
